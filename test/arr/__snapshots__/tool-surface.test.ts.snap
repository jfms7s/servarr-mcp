        "tvdbId",
        "qualityProfileId",
        "rootFolderPath",
      ],
      "type": "object",
    },
    "name": "sonarr_add_series",
  },
  {
    "description": "Remove a series from Sonarr. When deleteFiles=true without confirmDeleteFiles=true, returns what would be deleted as a safety check. Set confirmDeleteFiles=true to confirm the destructive operation.",
    "effect": "destructive",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
