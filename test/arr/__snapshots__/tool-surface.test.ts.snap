            "RescanSeries",
            "RenameFiles",
            "DownloadedEpisodesScan",
          ],
          "type": "string",
        },
        "seasonNumber": {
          "description": "Target season, for SeasonSearch",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "seriesId": {
          "description": "Target series, for series-scoped commands",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "sonarr_run_command",
  },
  {
    "description": "List episodes airing in a date range. Pass start and end for a predictable window; if they are omitted Sonarr chooses its own short range around today. Results are returned as { totalMatched, offset, limit, episodes }; default limit is 100 (pass limit and offset for other ranges). Rows omit the plot overview.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
