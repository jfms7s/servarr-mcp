SONARR_URL=http://localhost:8989
SONARR_API_KEY=
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
# Seerr (or Overseerr). OVERSEERR_URL/OVERSEERR_API_KEY still work, but set one pair only:
# a URL without its key fails startup.
SEERR_URL=http://localhost:5055
SEERR_API_KEY=
# Tautulli feeds servarr_media_cleanup_report only, and needs Radarr or Sonarr set too.
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=
# Transmission has no API key: the URL alone enables it (and its remove tool). Set both of these only if its RPC has auth on.
# TRANSMISSION_URL=http://localhost:9091
# TRANSMISSION_USERNAME=
# TRANSMISSION_PASSWORD=
SERVARR_MCP_TRANSPORT=stdio
SERVARR_MCP_PORT=3000
SERVARR_MCP_TOKEN=
