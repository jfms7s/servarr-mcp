          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "sonarr_get_queue",
  },
  {
    "description": "Trigger a Sonarr background command, for example searching for a series or rescanning its folder. Returns a command id; poll it with sonarr_get_command. MissingEpisodeSearch searches (and may download) every missing monitored episode, so without confirm=true it only returns { wouldRun: { command, missingCount }, confirmRequired: true } and runs nothing.",
    "effect": "write",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "description": "Required to run MissingEpisodeSearch, prevents an accidental library-wide search",
          "type": "boolean",
        },
        "episodeIds": {
          "description": "Target episodes, for EpisodeSearch",
          "items": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "type": "array",
        },
        "name": {
          "description": "Command to run",
          "enum": [
            "SeriesSearch",
            "EpisodeSearch",
            "SeasonSearch",
            "MissingEpisodeSearch",
