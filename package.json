{
  "name": "servarr-mcp",
  "version": "0.6.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "smoke": "node scripts/smoke.mjs dist",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "license": "MIT",
  "description": "MCP server for Sonarr, Radarr, Prowlarr and Overseerr",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "servarr-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "msw": "^3.0.3",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfms7s/servarr-mcp.git"
  },
  "keywords": [
    "mcp",
    "sonarr",
    "radarr",
    "prowlarr",
    "overseerr"
  ]
}
