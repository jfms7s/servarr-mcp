    },
    "name": "radarr_get_rename_preview",
  },
  {
    "description": "Find movies that appear to be the same film in more than one place. Reports exact duplicates (same tmdbId) and misplaced copies (same title+year under different root folders). Returns a compact grouping suitable for cleanup decisions. Results may be up to 30 s old (writes made through this server show up at once); pass refresh: true for a fresh read.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "description": "Download the library again instead of reusing a copy up to 30 s old (default false)",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "radarr_find_duplicate_movies",
  },
  {
    "description": "List available quality profiles. Use these ids in radarr_add_movie and radarr_update_movie.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "radarr_list_quality_profiles",
  },
  {
    "description": "List configured root folders where movies are stored (id, path, accessible, free space, unmapped folder count). Use these paths in radarr_add_movie; use radarr_list_unmapped_folders for the folders themselves.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "radarr_list_root_folders",
  },
  {
    "description": "List all tags available for movie organization.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "radarr_list_tags",
  },
  {
    "description": "Get Radarr status in one call: system (version, branch, OS, Docker, start time), health (the health check warnings and errors about the installation) and disks (free and total bytes on each drive containing movies or root folders).",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "radarr_get_status",
  },
  {
    "description": "Scan a folder and import any movie file found into an existing movie entry in Radarr. This is asynchronous — it returns a command id that can be polled with radarr_get_command. Important: the movie must already exist in Radarr for the file to attach to it; otherwise the scan will not import it. Use folderPath from radarr_list_unmapped_folders.",
    "effect": "destructive",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "importMode": {
          "description": "How to handle the file: Auto (default, let Radarr decide), Move (relocate to configured library), Copy (keep original, duplicate to library)",
          "enum": [
            "Auto",
            "Move",
            "Copy",
          ],
          "type": "string",
        },
        "path": {
          "description": "Absolute path to the folder to import, as returned by radarr_list_unmapped_folders (folderPath field)",
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
    "name": "radarr_import_folder",
  },
]
`;

exports[`arr tool surface > keeps every Sonarr tool as it is 1`] = `
[
  {
    "description": "List TV series in the Sonarr library with optional filters. Results are returned as { totalMatched, offset, limit, series } so pagination is visible. Default limit is 50 (pass limit and offset for different ranges). Filters are applied client-side after fetching all series, so titleContains and genre matches are case-insensitive substring/array searches. Rows omit the plot overview unless includeOverview is true. Results may be up to 30 s old (writes made through this server show up at once); pass refresh: true for a fresh read.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "genre": {
          "description": "Filter by genre (case-insensitive match against genres array)",
          "type": "string",
        },
        "includeOverview": {
          "description": "Include each row's plot overview (default false)",
          "type": "boolean",
        },
        "limit": {
          "description": "Maximum results to return (default 50)",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "monitored": {
          "description": "Filter by monitored state",
          "type": "boolean",
        },
        "offset": {
          "description": "Skip this many results (default 0)",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "refresh": {
          "description": "Download the library again instead of reusing a copy up to 30 s old (default false)",
          "type": "boolean",
        },
        "rootFolder": {
          "description": "Folder to filter by: a root folder or any folder beneath it, matched against the series folder. Matches whole path segments, so /media/shows does not match /media/shows-anime",
          "type": "string",
        },
        "seriesType": {
          "description": "Filter by series type",
          "enum": [
            "standard",
            "daily",
            "anime",
          ],
          "type": "string",
        },
        "titleContains": {
          "description": "Filter by title (case-insensitive substring match)",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "sonarr_list_series",
  },
  {
    "description": "Get one Sonarr series: the list summary plus every season (monitored, file and episode counts), root folder, season-folder setting and added date. full=true returns the raw Sonarr record.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "full": {
          "description": "Return the raw Sonarr record instead of the summary (default false)",
          "type": "boolean",
        },
        "seriesId": {
          "description": "Sonarr series id",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "seriesId",
      ],
      "type": "object",
    },
    "name": "sonarr_get_series",
  },
  {
    "description": "Search TheTVDB for series matching a search term. Use this to find the tvdbId needed by sonarr_add_series. Does not modify the library.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "term": {
          "description": "Series title to search for",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "term",
      ],
      "type": "object",
    },
    "name": "sonarr_lookup_series",
  },
  {
    "description": "Add a new series to Sonarr. Get tvdbId from sonarr_lookup_series, qualityProfileId from sonarr_list_quality_profiles, and rootFolderPath from sonarr_list_root_folders.",
    "effect": "write",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "monitored": {
          "description": "Monitor the series (default true)",
          "type": "boolean",
        },
        "qualityProfileId": {
          "description": "From sonarr_list_quality_profiles",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "rootFolderPath": {
          "description": "From sonarr_list_root_folders",
          "type": "string",
        },
        "searchForMissingEpisodes": {
          "description": "Start searching for episodes immediately (default false)",
          "type": "boolean",
        },
        "seasonFolder": {
          "description": "Use season folders (default true)",
          "type": "boolean",
        },
        "tags": {
          "description": "Tag ids from sonarr_list_tags",
          "items": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "type": "array",
        },
        "title": {
          "description": "Series title",
          "type": "string",
        },
        "tvdbId": {
          "description": "TheTVDB id, from sonarr_lookup_series",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
