          "type": "boolean",
        },
        "confirmDeleteFiles": {
          "description": "Required when deleteFiles=true, prevents accidental deletion",
          "type": "boolean",
        },
        "deleteFiles": {
          "description": "Also delete episode files (default false)",
          "type": "boolean",
        },
        "seriesId": {
          "description": "Sonarr series id",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "seriesId",
      ],
      "type": "object",
    },
    "name": "sonarr_delete_series",
  },
  {
    "description": "List items currently downloading or awaiting import, with percent complete and any error messages. Use this to diagnose stuck or failed downloads.",
    "effect": "read",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
