          "description": "Required with rootFolderPath: true moves the files, false repoints the record only",
          "type": "boolean",
        },
        "qualityProfileId": {
          "description": "From sonarr_list_quality_profiles",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "rootFolderPath": {
